<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>급식 알림</title>

  <!-- 모바일 앱처럼 보이게 -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- 구글 폰트 -->
  <link href="https://fonts.googleapis.com/css2?family=Pretendard&display=swap" rel="stylesheet">

  <style>
    body {
      margin: 0;
      font-family: 'Pretendard', sans-serif;
      background: linear-gradient(135deg, #4facfe, #00f2fe);
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app {
      background: white;
      width: 90%;
      max-width: 400px;
      border-radius: 20px;
      padding: 30px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
      text-align: center;
    }

    h1 {
      margin: 0;
      font-size: 24px;
      color: #333;
    }

    .status {
      margin-top: 30px;
      font-size: 18px;
      color: #666;
    }

    .class-box {
      margin: 20px 0;
      font-size: 32px;
      font-weight: bold;
      color: #4facfe;
    }

    button {
      width: 100%;
      padding: 15px;
      border: none;
      border-radius: 12px;
      font-size: 18px;
      background: #4facfe;
      color: white;
      cursor: pointer;
      transition: 0.2s;
    }

    button:hover {
      background: #3a8dde;
    }
  </style>
</head>

<body>

<div class="app">
  <h1>🍽 급식 순서</h1>

  <div class="status">현재 식사 중</div>
  <div class="class-box" id="currentClass">2학년 3반</div>

  <button onclick="nextClass()">다음 반</button>
</div>

<script>
  const classes = [
    "1학년 1반", "1학년 2반",
    "2학년 1반", "2학년 2반", "2학년 3반",
    "3학년 1반"
  ];

  let index = 2; // 시작 반 (원하는 값으로 수정)

  function nextClass() {
    index = (index + 1) % classes.length;
    document.getElementById("currentClass").innerText = classes[index];
  }
</script>

</body>
</html>
